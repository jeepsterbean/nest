{
  "identifier": "com.huwenjie.nest.demo",
  "build": {
    "beforeDevCommand": "VITE_NEST_DEMO=true npm run dev",
    "beforeBuildCommand": "VITE_NEST_DEMO=true npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "dashboard",
        "title": "Nest",
        "width": 900,
        "height": 700,
        "minWidth": 600,
        "minHeight": 500,
        "resizable": true,
        "maximizable": true,
        "visible": false,
        "center": true,
        "url": "index.html",
        "create": false
      },
      {
        "label": "popup",
        "title": "Nest",
        "width": 1040,
        "height": 460,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "url": "index.html#/popup",
        "create": false
      }
    ]
  }
}
